API_BASE_URL=http://localhost:8086/solicitacoes-mobile

# Credenciais usadas somente pelos route handlers do Next.
RECIPROCIDADE_FRONT_TOKEN=substituir_por_token_exclusivo
RECIPROCIDADE_CHAVE_FUNCIONALIDADE=substituir

# Somente para desenvolvimento local. Nunca usar em producao.
RECIPROCIDADE_DEV_AUTH_ENABLED=true
RECIPROCIDADE_DEV_CPF=00000000000

# Console visual temporario para diagnostico no WebView.
# Nunca habilitar em producao, pois exibe chavePasse e payloads funcionais.
DEBUG=false
